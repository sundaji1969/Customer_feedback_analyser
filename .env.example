# Copy this file to .env and fill in real values. Never commit .env!

# --- AI (OpenAI) ---
OPENAI_API_KEY=sk-your-key-here
# Small fast model for tags, stronger model for replies (compare with: python backend/eval_ai.py)
TAG_MODEL=gpt-4o-mini
REPLY_MODEL=gpt-5.5
# 0 = consistent tags. 0.3-0.5 = natural-sounding replies. Range 0-1.
TAG_TEMPERATURE=0
REPLY_TEMPERATURE=0.4
# Reviews sent to OpenAI at once, and max seconds per AI call
AI_CONCURRENCY=8
AI_TIMEOUT_SECONDS=60

# --- Database (PostgreSQL) ---
POSTGRES_USER=reviewlens
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reviewlens
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- App ---
BACKEND_URL=http://localhost:8000

# --- Email alert for new HIGH-urgency reviews (optional; leave empty to switch off) ---
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your Gmail address and
# SMTP_PASSWORD=an App Password (Google Account -> Security -> App passwords), not your normal password.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Link to the dashboard, shown in the email
DASHBOARD_URL=

# --- Dashboard password (optional locally; required on a server) ---
# The first password. Once someone changes or resets it in the dashboard, the new one
# is stored (hashed) in the database and this value is no longer used.
DASHBOARD_PASSWORD=
# Where "Forgot password?" sends the 6-digit reset code (uses the SMTP settings above).
# Empty = same as ALERT_EMAIL_TO.
RESET_EMAIL_TO=
